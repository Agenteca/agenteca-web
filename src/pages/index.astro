---
import Base from '../layouts/Base.astro';
import { api, type PackagePage, searchQuery, TOOLS } from '../lib/api';
import { failureSentence, parsePage, parseTool, TOOL_LABELS } from '../lib/format';

const i18n = Astro.locals.i18n;
const { t, plural } = i18n;

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim().slice(0, 200);
const tool = parseTool(params.get('tool'));
const page = parsePage(params.get('page'));

let result: PackagePage | undefined;
let failure: string | undefined;
try {
  result = await api.search({ q, ...(tool ? { tool } : {}), page });
} catch (e) {
  failure = failureSentence(e, i18n);
  Astro.response.status = 502;
}
const pageCount = result ? Math.max(1, Math.ceil(result.total / result.pageSize)) : 1;
const link = (p: number) => `/${searchQuery({ q, ...(tool ? { tool } : {}), page: p })}`;
const filtered = q !== '' || tool !== undefined;
---

<Base title={q ? t('Search: {0}', [q]) : t('Catalog')}>
  <h1>{t('Agent catalog')}</h1>
  <p class="lead">
    {t('Find an agent, read what it contains, then copy the command that installs it in your tool.')}
  </p>

  <form class="search" method="get" action="/" role="search" aria-label={t('Search the catalog')}>
    <div>
      <label for="q">{t('What are you looking for?')}</label>
      <div class="search-row">
        <input type="search" id="q" name="q" value={q} maxlength="200" placeholder={t('For example: code review')} autocomplete="off" />
        <button class="button" type="submit">{t('Search')}</button>
      </div>
    </div>
    <fieldset>
      <legend>{t('Compatible with')}</legend>
      <div class="choices">
        <label><input type="radio" name="tool" value="" checked={!tool} /> {t('All tools')}</label>
        {
          TOOLS.map((name) => (
            <label>
              <input type="radio" name="tool" value={name} checked={tool === name} /> {TOOL_LABELS[name]}
            </label>
          ))
        }
      </div>
    </fieldset>
  </form>

  {
    failure && (
      <div class="notice danger" role="alert">
        <p>{failure} {t('Try again in a moment.')}</p>
      </div>
    )
  }

  {
    result && (
      <section aria-labelledby="titre-resultats">
        <h2 id="titre-resultats">{t('Results')}</h2>
        <p role="status">
          <strong>
            {result.total === 0
              ? t('No package found')
              : filtered
                ? plural(result.total, '{0} package for this search|{0} packages for this search')
                : plural(result.total, '{0} package|{0} packages')}
          </strong>
        </p>
        {result.total === 0 && (
          <p>
            {filtered ? (
              <Fragment set:html={t('Try other words, or {0}show the whole catalog{1}.', ['<a href="/">', '</a>'])} />
            ) : (
              t('The catalog is still empty.')
            )}
          </p>
        )}
        <ul class="results">
          {result.items.map((p) => (
            <li class="card">
              <h3>
                <a href={`/packages/${p.id}`}>{p.name}</a>
              </h3>
              <p>{p.description ?? t('No description.')}</p>
              <ul class="meta" aria-label={t('Information about {0}', [p.name])}>
                {p.latestVersion && <li class="badge">{t('Version {0}', [p.latestVersion])}</li>}
                {p.tools.map((name) => (
                  <li class="badge">{TOOL_LABELS[name]}</li>
                ))}
                {p.license && <li class="badge">{t('License {0}', [p.license])}</li>}
              </ul>
            </li>
          ))}
        </ul>
        {pageCount > 1 && (
          <nav class="pagination" aria-label={t('Result pages')}>
            {page > 1 && (
              <a class="button secondary" href={link(page - 1)} rel="prev">
                {t('Previous page')}
              </a>
            )}
            <span>
              {t('Page {0} of {1}', [page, pageCount])}
            </span>
            {page < pageCount && (
              <a class="button secondary" href={link(page + 1)} rel="next">
                {t('Next page')}
              </a>
            )}
          </nav>
        )}
      </section>
    )
  }
</Base>
