---
import Base from '../../layouts/Base.astro';
import { api, ApiError, type FileContent, type PackageItem, type VersionDetail, type VersionItem } from '../../lib/api';
import { failureSentence, formatDate, formatSize, scanSentence, severityLabel, TOOL_LABELS } from '../../lib/format';

const i18n = Astro.locals.i18n;
const { t, plural, locale } = i18n;

const id = Number(Astro.params.id);
const wantedVersion = Astro.url.searchParams.get('version');
const wantedFile = Astro.url.searchParams.get('file');

let pkg: PackageItem | undefined;
let versions: VersionItem[] = [];
let detail: VersionDetail | undefined;
let file: FileContent | undefined;
let failure: { status: number; message: string } | undefined;

try {
  if (!Number.isInteger(id) || id < 1) throw new ApiError(404, 'not_found');
  pkg = await api.package(id);
  versions = (await api.versions(id)).items;
  const current = versions.find((v) => v.version === wantedVersion) ?? versions.find((v) => v.version === pkg!.latestVersion) ?? versions[0];
  if (current) {
    detail = await api.version(id, current.version);
    const target = wantedFile && detail.files.find((f) => f.path === wantedFile && f.hasContent);
    if (target) file = await api.file(id, current.version, target.path);
  }
} catch (e) {
  failure = { status: e instanceof ApiError ? e.status : 502, message: failureSentence(e, i18n) };
  Astro.response.status = failure.status;
}

const fileLink = (path: string) => `/packages/${id}?${new URLSearchParams({ ...(detail ? { version: detail.version } : {}), file: path })}#fichier`;
const versionLink = (v: string) => `/packages/${id}?${new URLSearchParams({ version: v })}`;
const c = detail?.contents;
const executes = c ? c.hooks.length + c.mcpServers.length : 0;
const scanClass = !detail ? '' : detail.scanBlocked ? 'danger' : detail.findings.length > 0 ? 'warning' : 'ok';
const isLatest = detail && pkg && detail.version === pkg.latestVersion;
const command = pkg && detail ? (isLatest ? pkg.installCommand : `ahub add ${pkg.repository}#${detail.ref}`) : '';
---

<Base title={pkg?.name ?? t('Package not found')} description={pkg?.description ?? undefined}>
  <p><a href="/">← {t('Back to the catalog')}</a></p>

  {
    failure && (
      <>
        <h1>{failure.status === 404 ? t('Package not found') : t('Catalog unreachable')}</h1>
        <div class="notice danger" role="alert">
          <p>{failure.status === 404 ? t('This package does not exist, or is no longer in the catalog.') : `${failure.message} ${t('Try again in a moment.')}`}</p>
        </div>
      </>
    )
  }

  {
    pkg && (
      <>
        <h1>{pkg.name}</h1>
        <p class="lead">{pkg.description ?? t('No description.')}</p>
        <ul class="meta" aria-label={t('Compatible tools and license')}>
          {pkg.tools.map((name) => (
            <li class="badge">{TOOL_LABELS[name]}</li>
          ))}
          {pkg.license && <li class="badge">{t('License {0}', [pkg.license])}</li>}
          {pkg.tags.map((tag) => (
            <li class="badge">{tag}</li>
          ))}
        </ul>

        {detail && (
          <section class="install" aria-labelledby="titre-installer">
            <h2 id="titre-installer">{isLatest ? t('Install') : t('Install version {0}', [detail.version])}</h2>
            <p>{t('Copy this command into a terminal, at the root of your project. It shows everything that will be written and asks for your agreement before acting.')}</p>
            <div class="command">
              <code id="commande">{command}</code>
              <button class="button" type="button" data-copy="commande" hidden>
                {t('Copy the command')}
              </button>
            </div>
            <p
              class="muted"
              role="status"
              aria-live="polite"
              data-copy-status
              data-copied={t('Command copied.')}
              data-failed={t('Could not copy: select the command by hand.')}
            />
            <p class="muted">
              <Fragment set:html={t('You need the {0} tool. To choose the target tools, add for example {1}.', ['<code>ahub</code>', '<code>--tool claude,cursor</code>'])} />
            </p>
          </section>
        )}

        {detail && c && (
          <>
            <section aria-labelledby="titre-securite">
              <h2 id="titre-securite">{t('Security check')}</h2>
              <div class={`notice ${scanClass}`}>
                <p>
                  <strong>{detail.scanBlocked ? t('Warning.') : detail.findings.length > 0 ? t('To check.') : t('Nothing to report.')}</strong>{' '}
                  {scanSentence(detail.findings, detail.scanBlocked, i18n)}
                </p>
              </div>
              {detail.findings.length > 0 && (
                <div class="table-scroll">
                  <table>
                    <caption class="visually-hidden">{t('Points found by the automatic check')}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{t('Severity')}</th>
                        <th scope="col">{t('File')}</th>
                        <th scope="col">{t('Finding')}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {detail.findings.map((f) => (
                        <tr>
                          <td>{severityLabel(f.severity, i18n)}</td>
                          <td>
                            <a href={fileLink(f.path)}>{f.path}</a>
                            {t(', line {0}', [f.line])}
                          </td>
                          <td>{f.message}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              <p class="muted">{t('This check spots known traps (invisible text, dangerous commands). It does not replace reading the content.')}</p>
            </section>

            <section aria-labelledby="titre-contenu">
              <h2 id="titre-contenu">{t('What this package installs')}</h2>
              {executes > 0 && (
                <div class="notice warning">
                  <p>
                    <strong>{t('This package runs programs.')}</strong>{' '}
                    {plural(
                      executes,
                      '{0} item below runs a command on your machine. Read it before installing.|{0} items below run a command on your machine. Read them before installing.',
                    )}
                  </p>
                </div>
              )}

              {c.skills.length > 0 && (
                <>
                  <h3>{t('Skills ({0})', [c.skills.length])}</h3>
                  <p class="muted">{t('Know-how the agent loads when it needs it.')}</p>
                  <ul class="plain">
                    {c.skills.map((s) => (
                      <li>
                        <strong>{s.name}</strong>
                        {s.description ? ` — ${s.description}` : ''}
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {c.agents.length > 0 && (
                <>
                  <h3>{t('Agents ({0})', [c.agents.length])}</h3>
                  <p class="muted">{t('Specialised assistants, with their own instructions.')}</p>
                  <ul class="plain">
                    {c.agents.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </>
              )}
              {c.commands.length > 0 && (
                <>
                  <h3>{t('Commands ({0})', [c.commands.length])}</h3>
                  <p class="muted">{t('Shortcuts to type in the tool.')}</p>
                  <ul class="plain">
                    {c.commands.map((a) => (
                      <li>
                        <code>/{a}</code>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {c.instructions.length > 0 && (
                <>
                  <h3>{t('Instructions ({0})', [c.instructions.length])}</h3>
                  <p class="muted">{t('Rules applied automatically to some files.')}</p>
                  <ul class="plain">
                    {c.instructions.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </>
              )}
              {c.hooks.length > 0 && (
                <>
                  <h3>{t('Automations ({0})', [c.hooks.length])}</h3>
                  <p class="muted">{t('Commands run automatically at certain moments ("hooks").')}</p>
                  <ul class="plain">
                    {c.hooks.map((h) => (
                      <li>
                        <strong>{h.name}</strong> — {t('runs on: {0}', [h.events.join(', ')])}
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {c.mcpServers.length > 0 && (
                <>
                  <h3>{t('Tool servers ({0})', [c.mcpServers.length])}</h3>
                  <p class="muted">{t('Programs that give the agent new tools (MCP servers).')}</p>
                  <ul class="plain">
                    {c.mcpServers.map((m) => (
                      <li>
                        <strong>{m.name}</strong> — <code>{m.command ? [m.command, ...(m.args ?? [])].join(' ') : (m.url ?? '')}</code>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </section>

            <section aria-labelledby="titre-fichiers">
              <h2 id="titre-fichiers">{t('Read the files ({0})', [detail.files.length])}</h2>
              <p>{t('Here is exactly what this version contains. Click a file to read it.')}</p>
              <ul class="plain">
                {detail.files.map((f) => (
                  <li>
                    {f.hasContent ? (
                      <a href={fileLink(f.path)} aria-current={file?.path === f.path ? 'true' : undefined}>
                        {f.path}
                      </a>
                    ) : (
                      <span>{f.path}</span>
                    )}{' '}
                    <span class="muted">
                      ({formatSize(f.size, locale)}
                      {f.hasContent ? '' : t(', binary file not shown')})
                    </span>
                  </li>
                ))}
              </ul>
              {file && (
                <div id="fichier" tabindex="-1">
                  <h3>{file.path}</h3>
                  <pre><code>{file.content}</code></pre>
                </div>
              )}
            </section>

            <section aria-labelledby="titre-details">
              <h2 id="titre-details">{t('Details')}</h2>
              <dl class="facts">
                <dt>{t('Version shown')}</dt>
                <dd>{detail.version}</dd>
                <dt>{t('Source')}</dt>
                <dd>
                  <code>{pkg.repository}</code>
                </dd>
                {detail.commit && (
                  <>
                    <dt>{t('Exact revision')}</dt>
                    <dd>
                      <code>{detail.commit}</code>
                    </dd>
                  </>
                )}
                <dt>{t('Read by the catalog on')}</dt>
                <dd>{formatDate(detail.indexedAt, locale)}</dd>
              </dl>
              {versions.length > 1 && (
                <>
                  <h3>{t('Other versions')}</h3>
                  <ul class="plain">
                    {versions.map((v) => (
                      <li>
                        <a href={versionLink(v.version)} aria-current={v.version === detail!.version ? 'true' : undefined}>
                          {v.version}
                        </a>
                        {v.version === pkg!.latestVersion ? t(' (latest)') : ''}
                        {v.scanBlocked ? t(' — critical problem found') : ''}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </section>
          </>
        )}
      </>
    )
  }
</Base>

<script>
  // Progressive enhancement: without JavaScript, the command stays readable and selectable.
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    if (!navigator.clipboard) continue;
    const source = document.getElementById(button.dataset.copy ?? '');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (!source) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(source.textContent ?? '');
        if (status) status.textContent = status.dataset.copied ?? '';
      } catch {
        if (status) status.textContent = status.dataset.failed ?? '';
      }
    });
  }
</script>
