{
  "name": "@agenteca/web",
  "version": "0.1.0",
  "private": true,
  "description": "Site du catalogue Agenteca : recherche, contenu des paquets avant installation, commande d'installation.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/agenteca/agenteca-web.git" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "astro": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "axe-core": "^4.10.2",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
